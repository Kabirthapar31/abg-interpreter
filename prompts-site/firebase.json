{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/prompts", "destination": "/index.html" },
      { "source": "/prompts/**", "destination": "/index.html" }
    ],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }]
  }
}
